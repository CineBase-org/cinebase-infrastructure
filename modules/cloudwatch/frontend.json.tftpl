
{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/CloudFront",
            "Requests",
            "Region", "Global",
            "DistributionId", "${cloudfront_distribution_id}"
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 300,
        "title": "CloudFront Requests"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 0,
      "width": 8,
